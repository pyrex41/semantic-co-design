{
  "name": "raft",
  "spec": "spec.shen",
  "step": "raft.step",
  "init": "raft.init",
  "symbols": ["none", "put", "get", "meta", "loading", "follower", "candidate", "leader",
              "vote", "app", "ok", "full"],
  "state": ["num", "num", "sym", "num", "num", "num",
            {"capacity": 8, "of": ["num", "sym", "num", "num", "num"]},
            "num", "num",
            ["num", "num"],
            ["bool", "bool", "bool", "bool", "bool"],
            ["num", "num", "num", "num", "num"],
            ["num", "num", "num", "num", "num"],
            "num", "num",
            ["num", "sym", "num", "num", "bool", "num"]],
  "events": {
    "restart": {"role": "restart"},
    "loaded": {"role": "disk-read-result", "fields": ["num", "num", "num", "num", "sym", "num", "num", "num"]},
    "written": {"role": "disk-ack", "fields": ["num"]},
    "alarm": {"role": "timer", "fields": ["num"]},
    "put": {"role": "request", "fields": ["num", "num", "num"]},
    "get": {"role": "request", "fields": ["num", "num"]},
    "on-vote-req": {"role": "recv", "fields": ["num", "num", "num", "num"]},
    "on-vote-rsp": {"role": "recv", "fields": ["num", "num", "bool"]},
    "on-app-req": {"role": "recv", "fields": ["num", "num", "num", "num", "bool", "num", "sym", "num", "num", "num", "num"]},
    "on-app-rsp": {"role": "recv", "fields": ["num", "num", "bool", "num"]}
  },
  "effects": {
    "read": {"role": "disk-read", "fields": ["num", "num"]},
    "write": {"role": "disk-write", "fields": ["num", "num", "num", "sym", "num", "num", "num"]},
    "arm": {"role": "timer-set", "fields": ["num", "num"]},
    "reply": {"role": "output", "fields": ["num", "sym", "num"]},
    "vote-req": {"role": "send", "deliver": "on-vote-req", "fields": ["num", "num", "num", "num"]},
    "vote-rsp": {"role": "send", "deliver": "on-vote-rsp", "fields": ["num", "num", "bool"]},
    "app-req": {"role": "send", "deliver": "on-app-req", "fields": ["num", "num", "num", "num", "bool", "num", "sym", "num", "num", "num", "num"]},
    "app-rsp": {"role": "send", "deliver": "on-app-rsp", "fields": ["num", "num", "bool", "num"]}
  },
  "max_effects": 8,
  "invariants": {"file": "invariants.shen", "state": [],
                 "trace": ["inv.election-safety", "inv.leader-append-only", "inv.log-matching",
                           "inv.leader-completeness", "inv.state-machine-safety",
                           "inv.replies-are-durable", "inv.commit-rule"]}
}
