mod RAILWAY-EXPLORE is
  sorts Route Train State .
  ops none r1 r2 : -> Route [ctor] .
  ops no yes : -> Train [ctor] .
  op st : Route Train Route -> State [ctor] .
  rl [request-r1] : st(none,no,none) => st(r1,no,r1) .
  rl [request-r2] : st(none,no,none) => st(r2,no,r2) .
  rl [cancel-r1] : st(r1,no,r1) => st(none,no,none) .
  rl [cancel-r2] : st(r2,no,r2) => st(none,no,none) .
  rl [entry-r1] : st(r1,no,r1) => st(r1,yes,r1) .
  rl [entry-r2] : st(r2,no,r2) => st(r2,yes,r2) .
  rl [clear-r1] : st(r1,yes,r1) => st(none,no,none) .
  rl [clear-r2] : st(r2,yes,r2) => st(none,no,none) .
endm
search [1] st(none,no,none) =>+ st(r1,yes,r2) .
search [1] st(none,no,none) =>+ st(r1,yes,r1) .
quit
