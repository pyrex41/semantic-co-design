\* Two routes share one switch and one protected block. *\
(define (railway-step route occupied event)
  (if (= (hd event) request)
      (if (= route none) (cons (tl event) false) (cons route occupied))
      (if (= (hd event) cancel)
          (if (and (= route (tl event)) (not occupied)) (cons none false) (cons route occupied))
          (if (= (hd event) entry)
              (if (and (= route (tl event)) (not occupied)) (cons route true) (cons route occupied))
              (if (and (= (hd event) clear) (= route (tl event)) occupied)
                  (cons none false) (cons route occupied))))))
