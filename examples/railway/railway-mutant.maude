mod RAILWAY-MUTANT is
  sorts Route Train State .
  ops none r1 r2 : -> Route [ctor] .
  ops no yes : -> Train [ctor] .
  op st : Route Train Route -> State [ctor] .
  rl [request-r1] : st(none,no,none) => st(r1,no,r1) .
  rl [entry-r1] : st(r1,no,r1) => st(r1,yes,r1) .
  *** Faulty cancellation releases the reservation while train remains.
  rl [faulty-cancel-r1] : st(r1,yes,r1) => st(none,yes,none) .
endm
search [1] st(none,no,none) =>+ st(none,yes,none) .
quit
